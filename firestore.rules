rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    // posting, liking, commenting and following need a verified email
    function verified() {
      return request.auth.token.email_verified == true;
    }

    // users/{username} belongs to the signed-in, verified user
    function isUser(username) {
      let path = /databases/$(database)/documents/users/$(username);
      return signedIn()
        && verified()
        && exists(path)
        && get(path).data.email.lower() == authEmail();
    }

    // a new doc has exactly these fields
    function hasExactly(keys) {
      return request.resource.data.keys().hasAll(keys)
        && request.resource.data.keys().hasOnly(keys);
    }

    // client time near server time, so posts can't jump the feed
    function isNow(time) {
      return time is int && math.abs(time - request.time.toMillis()) < 600000;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function added(field) {
      return request.resource.data.get(field, []).removeAll(resource.data.get(field, []));
    }

    function removed(field) {
      return resource.data.get(field, []).removeAll(request.resource.data.get(field, []));
    }

    // the only change is the user adding or removing themselves
    function togglesSelf(field) {
      let changed = added(field).concat(removed(field));
      return changed.size() == 1 && isUser(changed[0]);
    }

    // the only change is the user removing themselves
    function removesSelf(field) {
      return added(field).size() == 0
        && removed(field).size() == 1
        && isUser(removed(field)[0]);
    }

    // profile pictures are small data URLs stored on the user doc
    // older users have no bio field
    function validBio() {
      let bio = request.resource.data.get('bio', '');
      return bio is string && bio.size() <= 150;
    }

    // older users have no pet field; every detail is optional
    function validPet() {
      let pet = request.resource.data.get('pet', {});
      return pet is map
        && pet.keys().hasOnly(['species', 'breed', 'birthYear', 'city'])
        && pet.get('species', 'other')
          in ['dog', 'cat', 'rabbit', 'bird', 'fish', 'reptile', 'other']
        && pet.get('breed', '') is string
        && pet.get('breed', '').size() <= 40
        && pet.get('city', '') is string
        && pet.get('city', '').size() <= 40
        && (!('birthYear' in pet)
          || (pet.birthYear is int
            && pet.birthYear >= 1980
            && pet.birthYear <= request.time.year()));
    }

    function validProfilePic() {
      let pic = request.resource.data.profilePic;
      return pic == resource.data.profilePic
        || (pic is string
          && pic.size() < 100000
          && pic.split(',')[0] in ['data:image/webp;base64', 'data:image/jpeg;base64']);
    }

    match /users/{username} {
      allow read: if true;

      allow create: if signedIn()
        && hasExactly(['email', 'username', 'usernameLower', 'follower',
          'following', 'likes', 'comments', 'profilePic', 'bio', 'pet'])
        && username.matches('^[^/]{2,15}$')
        && request.resource.data.username == username
        && request.resource.data.usernameLower == username.lower()
        && request.resource.data.email.lower() == authEmail()
        && request.resource.data.follower == []
        && request.resource.data.following == []
        && request.resource.data.likes == []
        && request.resource.data.comments == []
        && request.resource.data.profilePic == ''
        && request.resource.data.bio == ''
        && request.resource.data.pet == {};

      // owners edit their profile, not their identity or followers
      allow update: if signedIn()
        && verified()
        && resource.data.email.lower() == authEmail()
        && onlyChanges(['following', 'likes', 'comments', 'profilePic', 'follower', 'bio', 'pet'])
        && added('follower').size() == 0
        && validProfilePic()
        && validBio()
        && validPet();

      // others follow, unfollow or clean up after deleting
      allow update: if onlyChanges(['follower']) && togglesSelf('follower');
      allow update: if onlyChanges(['following']) && removesSelf('following');

      // unverified users can still delete their account
      allow delete: if signedIn() && resource.data.email.lower() == authEmail();
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if isUser(request.resource.data.user)
        && hasExactly(['id', 'user', 'userPic', 'caption', 'urlPic', 'likes', 'created'])
        && request.resource.data.id == postId
        && request.resource.data.likes == []
        && request.resource.data.urlPic == ''
        && request.resource.data.userPic == ''
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 2200
        && isNow(request.resource.data.created);

      allow update: if onlyChanges(['likes']) && togglesSelf('likes');

      // authors can edit their caption
      allow update: if isUser(resource.data.user)
        && onlyChanges(['caption'])
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 2200;

      allow delete: if isUser(resource.data.user);
    }

    match /comments/{commentId} {
      allow read: if true;

      allow create: if isUser(request.resource.data.username)
        && hasExactly(['commentId', 'postId', 'text', 'username', 'userPic', 'created'])
        && request.resource.data.commentId == commentId
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.userPic == ''
        && isNow(request.resource.data.created)
        && exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));

      // the comment's or the post's author
      allow delete: if isUser(resource.data.username)
        || isUser(get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.user);
    }

    // a post's picture as a data URL
    match /images/{postId} {
      allow read: if true;

      // only together with its post, in the same batch
      allow create: if isUser(request.resource.data.owner)
        && hasExactly(['owner', 'src'])
        && request.resource.data.src is string
        && request.resource.data.src.size() < 800000
        && getAfter(/databases/$(database)/documents/posts/$(postId)).data.user
          == request.resource.data.owner;

      allow delete: if isUser(resource.data.owner);
    }
  }
}
