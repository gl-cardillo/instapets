rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // users/{username} in Firestore belongs to the signed-in account
    function isUser(username) {
      return request.auth != null
        && request.auth.token.email != null
        && firestore.get(/databases/(default)/documents/users/$(username)).data.email.lower()
          == request.auth.token.email.lower();
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    match /profilePic/{username} {
      allow read: if true;
      allow create, update: if isUser(username) && isImage();
      allow delete: if isUser(username);
    }

    match /postPic/{postId} {
      allow read: if true;
      // the picture is uploaded before its post doc exists
      allow create: if request.auth != null && isImage();
      allow update, delete: if isUser(
        firestore.get(/databases/(default)/documents/posts/$(postId)).data.user);
    }
  }
}
